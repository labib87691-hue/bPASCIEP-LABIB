{
  "entities": {
    "SiteContent": {
      "title": "SiteContent",
      "description": "General institutional content sections such as About, History, Mission, Vision, and Admission info.",
      "type": "object",
      "properties": {
        "sectionKey": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "titleBn": { "type": "string", "minLength": 1, "maxLength": 300 },
        "titleEn": { "type": "string", "minLength": 1, "maxLength": 300 },
        "bodyBn": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "bodyEn": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "isPublished": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sectionKey", "titleBn", "titleEn", "bodyBn", "bodyEn", "isPublished", "updatedAt"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Homepage hero banner slides with authentic school photography.",
      "type": "object",
      "properties": {
        "titleBn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "titleEn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "subtitleBn": { "type": "string", "minLength": 0, "maxLength": 500 },
        "subtitleEn": { "type": "string", "minLength": 0, "maxLength": 500 },
        "imageUrl": { "type": "string", "minLength": 1, "maxLength": 500 },
        "order": { "type": "number" },
        "isPublished": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["titleBn", "titleEn", "imageUrl", "order", "isPublished", "createdAt"]
    },
    "AdminMember": {
      "title": "AdminMember",
      "description": "Executive Chairman, Executive Director, Principal, and administrative officials.",
      "type": "object",
      "properties": {
        "roleKey": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "designationBn": { "type": "string", "minLength": 1, "maxLength": 300 },
        "designationEn": { "type": "string", "minLength": 1, "maxLength": 300 },
        "organizationBn": { "type": "string", "minLength": 1, "maxLength": 300 },
        "organizationEn": { "type": "string", "minLength": 1, "maxLength": 300 },
        "messageBn": { "type": "string", "minLength": 0, "maxLength": 8000 },
        "messageEn": { "type": "string", "minLength": 0, "maxLength": 8000 },
        "photoUrl": { "type": "string", "minLength": 0, "maxLength": 500 },
        "order": { "type": "number" },
        "isPublished": { "type": "boolean" }
      },
      "required": ["roleKey", "name", "designationBn", "designationEn", "order", "isPublished"]
    },
    "GoverningBodyMember": {
      "title": "GoverningBodyMember",
      "description": "Verified Governing Body members of BPSC, Ishwardi EPZ.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "boardRoleBn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "boardRoleEn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "designationBn": { "type": "string", "minLength": 1, "maxLength": 300 },
        "designationEn": { "type": "string", "minLength": 1, "maxLength": 300 },
        "photoUrl": { "type": "string", "minLength": 0, "maxLength": 500 },
        "order": { "type": "number" },
        "isPublished": { "type": "boolean" }
      },
      "required": ["name", "boardRoleBn", "boardRoleEn", "designationBn", "designationEn", "order", "isPublished"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Public directory profile of BPSC faculty members.",
      "type": "object",
      "properties": {
        "serial": { "type": "number" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "designationBn": { "type": "string", "minLength": 1, "maxLength": 250 },
        "designationEn": { "type": "string", "minLength": 1, "maxLength": 250 },
        "department": { "type": "string", "minLength": 1, "maxLength": 120 },
        "subjectBn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "subjectEn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "qualification": { "type": "string", "minLength": 0, "maxLength": 600 },
        "photoUrl": { "type": "string", "minLength": 0, "maxLength": 500 },
        "publicEmail": { "type": "string", "minLength": 0, "maxLength": 160 },
        "publicPhone": { "type": "string", "minLength": 0, "maxLength": 60 },
        "isPublished": { "type": "boolean" }
      },
      "required": ["serial", "name", "designationBn", "designationEn", "department", "subjectBn", "subjectEn", "isPublished"]
    },
    "StaffMember": {
      "title": "StaffMember",
      "description": "Public directory profile of BPSC administrative and support staff.",
      "type": "object",
      "properties": {
        "serial": { "type": "number" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "designationBn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "designationEn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "photoUrl": { "type": "string", "minLength": 0, "maxLength": 500 },
        "publicPhone": { "type": "string", "minLength": 0, "maxLength": 60 },
        "publicEmail": { "type": "string", "minLength": 0, "maxLength": 160 },
        "isPublished": { "type": "boolean" }
      },
      "required": ["serial", "name", "designationBn", "designationEn", "isPublished"]
    },
    "AcademicClass": {
      "title": "AcademicClass",
      "description": "Academic level information from Nursery to Class 10.",
      "type": "object",
      "properties": {
        "levelOrder": { "type": "number" },
        "classCode": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "nameBn": { "type": "string", "minLength": 1, "maxLength": 120 },
        "nameEn": { "type": "string", "minLength": 1, "maxLength": 120 },
        "sectionGroupBn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sectionGroupEn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "descriptionBn": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "descriptionEn": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "routineUrl": { "type": "string", "minLength": 0, "maxLength": 500 },
        "syllabusUrl": { "type": "string", "minLength": 0, "maxLength": 500 },
        "isPublished": { "type": "boolean" }
      },
      "required": ["levelOrder", "classCode", "nameBn", "nameEn", "sectionGroupBn", "sectionGroupEn", "descriptionBn", "descriptionEn", "isPublished"]
    },
    "AcademicResource": {
      "title": "AcademicResource",
      "description": "Class routines, exam routines, syllabi, course plans, and academic calendar items.",
      "type": "object",
      "properties": {
        "resourceType": { "type": "string", "enum": ["class_routine", "exam_routine", "syllabus", "course_plan", "calendar"] },
        "titleBn": { "type": "string", "minLength": 1, "maxLength": 300 },
        "titleEn": { "type": "string", "minLength": 1, "maxLength": 300 },
        "classNameBn": { "type": "string", "minLength": 1, "maxLength": 120 },
        "classNameEn": { "type": "string", "minLength": 1, "maxLength": 120 },
        "publishDate": { "type": "string", "minLength": 1, "maxLength": 40 },
        "fileUrl": { "type": "string", "minLength": 0, "maxLength": 500 },
        "order": { "type": "number" },
        "isPublished": { "type": "boolean" }
      },
      "required": ["resourceType", "titleBn", "titleEn", "classNameBn", "classNameEn", "publishDate", "order", "isPublished"]
    },
    "Notice": {
      "title": "Notice",
      "description": "Official school notices, office orders, exam notices, and admission circulars.",
      "type": "object",
      "properties": {
        "serial": { "type": "number" },
        "titleBn": { "type": "string", "minLength": 1, "maxLength": 400 },
        "titleEn": { "type": "string", "minLength": 1, "maxLength": 400 },
        "category": { "type": "string", "enum": ["academic", "admission", "examination", "recruitment", "general"] },
        "publishDate": { "type": "string", "minLength": 1, "maxLength": 40 },
        "summaryBn": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "summaryEn": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "attachmentUrl": { "type": "string", "minLength": 0, "maxLength": 500 },
        "externalUrl": { "type": "string", "minLength": 0, "maxLength": 500 },
        "isImportant": { "type": "boolean" },
        "isPublished": { "type": "boolean" }
      },
      "required": ["serial", "titleBn", "titleEn", "category", "publishDate", "summaryBn", "summaryEn", "isImportant", "isPublished"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Categorized institutional gallery photograph.",
      "type": "object",
      "properties": {
        "titleBn": { "type": "string", "minLength": 1, "maxLength": 250 },
        "titleEn": { "type": "string", "minLength": 1, "maxLength": 250 },
        "category": { "type": "string", "enum": ["campus", "events", "science_fair", "cultural", "guardians_meeting", "transport"] },
        "imageUrl": { "type": "string", "minLength": 1, "maxLength": 500 },
        "dateLabel": { "type": "string", "minLength": 0, "maxLength": 60 },
        "order": { "type": "number" },
        "isPublished": { "type": "boolean" }
      },
      "required": ["titleBn", "titleEn", "category", "imageUrl", "order", "isPublished"]
    },
    "NewsItem": {
      "title": "NewsItem",
      "description": "Published institutional news and achievement updates.",
      "type": "object",
      "properties": {
        "titleBn": { "type": "string", "minLength": 1, "maxLength": 400 },
        "titleEn": { "type": "string", "minLength": 1, "maxLength": 400 },
        "publishDate": { "type": "string", "minLength": 1, "maxLength": 40 },
        "summaryBn": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "summaryEn": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "imageUrl": { "type": "string", "minLength": 0, "maxLength": 500 },
        "category": { "type": "string", "minLength": 1, "maxLength": 80 },
        "isPublished": { "type": "boolean" }
      },
      "required": ["titleBn", "titleEn", "publishDate", "summaryBn", "summaryEn", "category", "isPublished"]
    },
    "EventItem": {
      "title": "EventItem",
      "description": "School events, science fairs, cultural celebrations, and guardian assemblies.",
      "type": "object",
      "properties": {
        "titleBn": { "type": "string", "minLength": 1, "maxLength": 300 },
        "titleEn": { "type": "string", "minLength": 1, "maxLength": 300 },
        "eventDate": { "type": "string", "minLength": 1, "maxLength": 60 },
        "descriptionBn": { "type": "string", "minLength": 1, "maxLength": 2500 },
        "descriptionEn": { "type": "string", "minLength": 1, "maxLength": 2500 },
        "imageUrl": { "type": "string", "minLength": 0, "maxLength": 500 },
        "isPublished": { "type": "boolean" }
      },
      "required": ["titleBn", "titleEn", "eventDate", "descriptionBn", "descriptionEn", "isPublished"]
    },
    "Facility": {
      "title": "Facility",
      "description": "Verified campus infrastructure and student facilities.",
      "type": "object",
      "properties": {
        "titleBn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "titleEn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "descriptionBn": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "descriptionEn": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "imageUrl": { "type": "string", "minLength": 0, "maxLength": 500 },
        "order": { "type": "number" },
        "isPublished": { "type": "boolean" }
      },
      "required": ["titleBn", "titleEn", "descriptionBn", "descriptionEn", "order", "isPublished"]
    },
    "TransportInfo": {
      "title": "TransportInfo",
      "description": "Verified school transport vehicles, driver info, and service details.",
      "type": "object",
      "properties": {
        "titleBn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "titleEn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "descriptionBn": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "descriptionEn": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "imageUrl": { "type": "string", "minLength": 0, "maxLength": 500 },
        "order": { "type": "number" },
        "isPublished": { "type": "boolean" }
      },
      "required": ["titleBn", "titleEn", "descriptionBn", "descriptionEn", "order", "isPublished"]
    },
    "SiteSetting": {
      "title": "SiteSetting",
      "description": "Public institutional settings, EIIN, established year, verified statistics, and contact info.",
      "type": "object",
      "properties": {
        "schoolNameBn": { "type": "string", "minLength": 1, "maxLength": 250 },
        "schoolNameEn": { "type": "string", "minLength": 1, "maxLength": 250 },
        "eiin": { "type": "string", "minLength": 1, "maxLength": 20 },
        "establishedYear": { "type": "string", "minLength": 1, "maxLength": 20 },
        "addressBn": { "type": "string", "minLength": 1, "maxLength": 300 },
        "addressEn": { "type": "string", "minLength": 1, "maxLength": 300 },
        "phonePrimary": { "type": "string", "minLength": 1, "maxLength": 40 },
        "phoneSecondary": { "type": "string", "minLength": 0, "maxLength": 40 },
        "emailPrimary": { "type": "string", "minLength": 1, "maxLength": 160 },
        "emailSecondary": { "type": "string", "minLength": 0, "maxLength": 160 },
        "totalStudents": { "type": "string", "minLength": 0, "maxLength": 40 },
        "totalTeachers": { "type": "number" },
        "totalClasses": { "type": "number" },
        "isPublished": { "type": "boolean" }
      },
      "required": ["schoolNameBn", "schoolNameEn", "eiin", "establishedYear", "addressBn", "addressEn", "phonePrimary", "emailPrimary", "totalTeachers", "totalClasses", "isPublished"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Submitted public contact inquiry containing visitor PII (admin-readable only).",
      "type": "object",
      "properties": {
        "senderName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "senderEmail": { "type": "string", "minLength": 5, "maxLength": 160, "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$" },
        "senderPhone": { "type": "string", "minLength": 6, "maxLength": 30, "pattern": "^[0-9+\\-\\s()]{6,30}$" },
        "subject": { "type": "string", "minLength": 3, "maxLength": 200 },
        "message": { "type": "string", "minLength": 10, "maxLength": 3000 },
        "status": { "type": "string", "enum": ["new", "read", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderName", "senderEmail", "senderPhone", "subject", "message", "status", "createdAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Trusted administrator registry document keyed by user UID.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "minLength": 5, "maxLength": 160 },
        "role": { "type": "string", "enum": ["master_admin", "editor"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "createdAt"]
    },
    "AuthorizedTeacher": {
      "title": "AuthorizedTeacher",
      "description": "Trusted faculty registry document keyed by teacher UID with Phase 5 permissions and profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "minLength": 5, "maxLength": 160 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "teacherId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "teacherRole": { "type": "string", "enum": ["subject_teacher", "class_teacher"] },
        "assignedClasses": { "type": "array" },
        "assignedSections": { "type": "array" },
        "assignedSubjects": { "type": "array" },
        "isClassTeacher": { "type": "boolean" },
        "classTeacherOf": { "type": "string", "minLength": 0, "maxLength": 60 },
        "canEnterMarks": { "type": "boolean" },
        "canSubmitResults": { "type": "boolean" },
        "canTakeAttendance": { "type": "boolean" },
        "canViewStudents": { "type": "boolean" },
        "canAccessCloud": { "type": "boolean" },
        "canViewNotices": { "type": "boolean" },
        "canEditProfile": { "type": "boolean" },
        "canEditDraftMarks": { "type": "boolean" },
        "phone": { "type": "string", "minLength": 0, "maxLength": 40 },
        "designation": { "type": "string", "minLength": 0, "maxLength": 120 },
        "department": { "type": "string", "minLength": 0, "maxLength": 120 },
        "qualification": { "type": "string", "minLength": 0, "maxLength": 600 },
        "photoUrl": { "type": "string", "minLength": 0, "maxLength": 600 },
        "bio": { "type": "string", "minLength": 0, "maxLength": 2000 },
        "officeHours": { "type": "string", "minLength": 0, "maxLength": 200 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "teacherId", "isActive", "createdAt"]
    },
    "AcademicYear": {
      "title": "AcademicYear",
      "description": "Academic year catalog used by the Result Portal and Result Management system.",
      "type": "object",
      "properties": {
        "yearCode": { "type": "string", "minLength": 4, "maxLength": 20, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "labelBn": { "type": "string", "minLength": 1, "maxLength": 120 },
        "labelEn": { "type": "string", "minLength": 1, "maxLength": 120 },
        "isCurrent": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "order": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["yearCode", "labelBn", "labelEn", "isCurrent", "isActive", "order", "updatedAt"]
    },
    "Examination": {
      "title": "Examination",
      "description": "Institutional examination definition linked to an AcademicYear and applicable classes.",
      "type": "object",
      "properties": {
        "examCode": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "academicYearId": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "nameBn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "nameEn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "termType": { "type": "string", "enum": ["mid_term_1", "half_yearly", "mid_term_2", "annual", "pre_test", "test", "model_test"] },
        "applicableClasses": { "type": "array" },
        "examSessionBn": { "type": "string", "minLength": 0, "maxLength": 80 },
        "examSessionEn": { "type": "string", "minLength": 0, "maxLength": 80 },
        "showPosition": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["examCode", "academicYearId", "nameBn", "nameEn", "termType", "applicableClasses", "showPosition", "isActive", "order", "createdAt", "updatedAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Private student enrollment record containing guardian PII (strictly restricted to authorized admins and teachers).",
      "type": "object",
      "properties": {
        "studentCode": { "type": "string", "minLength": 0, "maxLength": 60 },
        "academicYearId": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "classCode": { "type": "string", "enum": ["nursery", "class-1", "class-2", "class-3", "class-4", "class-5", "class-6", "class-7", "class-8", "class-9", "class-10"] },
        "rollNumber": { "type": "string", "minLength": 1, "maxLength": 6, "pattern": "^[1-9][0-9]{0,5}$" },
        "fullNameEn": { "type": "string", "minLength": 1, "maxLength": 160 },
        "fullNameBn": { "type": "string", "minLength": 0, "maxLength": 160 },
        "section": { "type": "string", "minLength": 0, "maxLength": 40 },
        "groupNameEn": { "type": "string", "minLength": 0, "maxLength": 60 },
        "groupNameBn": { "type": "string", "minLength": 0, "maxLength": 60 },
        "guardianName": { "type": "string", "minLength": 0, "maxLength": 160 },
        "guardianPhone": { "type": "string", "minLength": 0, "maxLength": 30 },
        "isActive": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["academicYearId", "classCode", "rollNumber", "fullNameEn", "isActive", "updatedAt"]
    },
    "SubjectConfig": {
      "title": "SubjectConfig",
      "description": "Class-specific subject configuration supporting full marks, pass marks, practicals, and optional 4th subjects.",
      "type": "object",
      "properties": {
        "subjectCode": { "type": "string", "minLength": 1, "maxLength": 30, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "classCode": { "type": "string", "enum": ["nursery", "class-1", "class-2", "class-3", "class-4", "class-5", "class-6", "class-7", "class-8", "class-9", "class-10"] },
        "nameBn": { "type": "string", "minLength": 1, "maxLength": 160 },
        "nameEn": { "type": "string", "minLength": 1, "maxLength": 160 },
        "fullMarks": { "type": "number" },
        "passMarks": { "type": "number" },
        "hasComponents": { "type": "boolean" },
        "writtenFullMarks": { "type": "number" },
        "writtenPassMarks": { "type": "number" },
        "mcqFullMarks": { "type": "number" },
        "mcqPassMarks": { "type": "number" },
        "hasPractical": { "type": "boolean" },
        "practicalFullMarks": { "type": "number" },
        "practicalPassMarks": { "type": "number" },
        "isOptional": { "type": "boolean" },
        "displayOrder": { "type": "number" },
        "isActive": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subjectCode", "classCode", "nameBn", "nameEn", "fullMarks", "passMarks", "hasComponents", "hasPractical", "isOptional", "displayOrder", "isActive", "updatedAt"]
    },
    "GradingRule": {
      "title": "GradingRule",
      "description": "Configurable grading scale, pass threshold, optional subject bonus, and GPA formula definition.",
      "type": "object",
      "properties": {
        "ruleCode": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "nameBn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "nameEn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "descriptionBn": { "type": "string", "minLength": 1, "maxLength": 800 },
        "descriptionEn": { "type": "string", "minLength": 1, "maxLength": 800 },
        "maxGpa": { "type": "number" },
        "defaultPassPercentage": { "type": "number" },
        "requireComponentPass": { "type": "boolean" },
        "enableOptionalBonus": { "type": "boolean" },
        "optionalBonusThreshold": { "type": "number" },
        "calculateGpa": { "type": "boolean" },
        "calculatePercentage": { "type": "boolean" },
        "gradeScale": { "type": "array" },
        "isActive": { "type": "boolean" },

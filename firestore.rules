    }

    function isValidStudentResult(data) {
      return data.keys().hasAll(['academicYearId', 'academicYearLabelBn', 'academicYearLabelEn', 'examId', 'examNameBn', 'examNameEn', 'classCode', 'classNameBn', 'classNameEn', 'rollNumber', 'studentId', 'studentNameEn', 'gradingRuleId', 'totalFullMarks', 'obtainedTotalMarks', 'calculateGpa', 'calculatePercentage', 'maxGpa', 'letterGrade', 'finalStatus', 'compulsorySubjectCount', 'failedCompulsoryCount', 'showPosition', 'workflowStatus', 'isPublished', 'isDemoRecord', 'enteredByUid', 'updatedAt'])
        && data.keys().hasOnly([
          'academicYearId',
          'academicYearLabelBn',
          'academicYearLabelEn',
          'examId',
          'examNameBn',
          'examNameEn',
          'classCode',
          'classNameBn',
          'classNameEn',
          'rollNumber',
          'studentId',
          'studentCode',
          'studentNameEn',
          'studentNameBn',
          'section',
          'groupNameEn',
          'groupNameBn',
          'gradingRuleId',
          'totalFullMarks',
          'obtainedTotalMarks',
          'percentage',
          'gpa',
          'gpaWithoutOptional',
          'calculateGpa',
          'calculatePercentage',
          'maxGpa',
          'letterGrade',
          'finalStatus',
          'compulsorySubjectCount',
          'failedCompulsoryCount',
          'position',
          'showPosition',
          'workflowStatus',
          'isPublished',
          'rejectionReason',
          'publishedDateLabelBn',
          'publishedDateLabelEn',
          'isDemoRecord',
          'enteredByUid',
          'updatedAt'
        ])
        && data.academicYearId is string && data.academicYearId.size() >= 1 && data.academicYearId.size() <= 60 && data.academicYearId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.academicYearLabelBn is string && data.academicYearLabelBn.size() >= 1 && data.academicYearLabelBn.size() <= 120
        && data.academicYearLabelEn is string && data.academicYearLabelEn.size() >= 1 && data.academicYearLabelEn.size() <= 120
        && data.examId is string && data.examId.size() >= 1 && data.examId.size() <= 100 && data.examId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.examNameBn is string && data.examNameBn.size() >= 1 && data.examNameBn.size() <= 200
        && data.examNameEn is string && data.examNameEn.size() >= 1 && data.examNameEn.size() <= 200
        && isValidSupportedClassCode(data.classCode)
        && data.classNameBn is string && data.classNameBn.size() >= 1 && data.classNameBn.size() <= 80
        && data.classNameEn is string && data.classNameEn.size() >= 1 && data.classNameEn.size() <= 80
        && data.rollNumber is string && data.rollNumber.size() >= 1 && data.rollNumber.size() <= 6 && data.rollNumber.matches('^[1-9][0-9]{0,5}$')
        && data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 && data.studentId.matches('^[a-zA-Z0-9_\\-]+$')
        && isOptionalString(data, 'studentCode', 60)
        && data.studentNameEn is string && data.studentNameEn.size() >= 1 && data.studentNameEn.size() <= 160
        && isOptionalString(data, 'studentNameBn', 160)
        && isOptionalString(data, 'section', 40)
        && isOptionalString(data, 'groupNameEn', 60)
        && isOptionalString(data, 'groupNameBn', 60)
        && data.gradingRuleId is string && data.gradingRuleId.size() >= 1 && data.gradingRuleId.size() <= 80 && data.gradingRuleId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.totalFullMarks is number && data.totalFullMarks > 0 && data.totalFullMarks <= 3000
        && data.obtainedTotalMarks is number && data.obtainedTotalMarks >= 0 && data.obtainedTotalMarks <= data.totalFullMarks
        && isOptionalNullableNumber(data, 'percentage', 0, 100)
        && isOptionalNullableNumber(data, 'gpa', 0, 10)
        && isOptionalNullableNumber(data, 'gpaWithoutOptional', 0, 10)
        && data.calculateGpa is bool
        && data.calculatePercentage is bool
        && data.maxGpa is number && data.maxGpa >= 1 && data.maxGpa <= 10
        && data.letterGrade is string && data.letterGrade.size() >= 1 && data.letterGrade.size() <= 10
        && data.finalStatus is string && data.finalStatus in ['PASS', 'FAIL']
        && data.compulsorySubjectCount is number && data.compulsorySubjectCount >= 1 && data.compulsorySubjectCount <= 25
        && data.failedCompulsoryCount is number && data.failedCompulsoryCount >= 0 && data.failedCompulsoryCount <= 25
        && isOptionalNullableNumber(data, 'position', 1, 10000)
        && data.showPosition is bool
        && data.workflowStatus is string && data.workflowStatus in ['draft', 'submitted', 'approved', 'rejected', 'published', 'unpublished']
        && data.isPublished is bool
        && ((data.isPublished == true && data.workflowStatus == 'published') || (data.isPublished == false && data.workflowStatus != 'published'))
        && isOptionalNullableString(data, 'rejectionReason', 400)
        && isOptionalString(data, 'publishedDateLabelBn', 60)
        && isOptionalString(data, 'publishedDateLabelEn', 60)
        && data.isDemoRecord is bool
        && data.enteredByUid is string && data.enteredByUid.size() >= 1 && data.enteredByUid.size() <= 128
        && data.updatedAt == request.time;
    }

    function isValidResultSubject(data) {
      return data.keys().hasAll(['resultId', 'academicYearId', 'examId', 'classCode', 'rollNumber', 'subjectId', 'subjectCode', 'subjectNameBn', 'subjectNameEn', 'fullMarks', 'passMarks', 'isOptional', 'hasComponents', 'hasPractical', 'obtainedMarks', 'isAbsent', 'letterGrade', 'gradePoint', 'isPassed', 'displayOrder', 'isPublished', 'updatedAt'])
        && data.keys().hasOnly(['resultId', 'academicYearId', 'examId', 'classCode', 'rollNumber', 'subjectId', 'subjectCode', 'subjectNameBn', 'subjectNameEn', 'fullMarks', 'passMarks', 'isOptional', 'hasComponents', 'hasPractical', 'writtenFullMarks', 'mcqFullMarks', 'practicalFullMarks', 'writtenMarks', 'mcqMarks', 'practicalMarks', 'obtainedMarks', 'isAbsent', 'letterGrade', 'gradePoint', 'isPassed', 'displayOrder', 'isPublished', 'updatedAt'])
        && data.resultId is string && data.resultId.size() >= 1 && data.resultId.size() <= 128 && data.resultId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.academicYearId is string && data.academicYearId.size() >= 1 && data.academicYearId.size() <= 60 && data.academicYearId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.examId is string && data.examId.size() >= 1 && data.examId.size() <= 100 && data.examId.matches('^[a-zA-Z0-9_\\-]+$')
        && isValidSupportedClassCode(data.classCode)
        && data.rollNumber is string && data.rollNumber.size() >= 1 && data.rollNumber.size() <= 6 && data.rollNumber.matches('^[1-9][0-9]{0,5}$')
        && data.subjectId is string && data.subjectId.size() >= 1 && data.subjectId.size() <= 100 && data.subjectId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.subjectCode is string && data.subjectCode.size() >= 1 && data.subjectCode.size() <= 30 && data.subjectCode.matches('^[a-zA-Z0-9_\\-]+$')
        && data.subjectNameBn is string && data.subjectNameBn.size() >= 1 && data.subjectNameBn.size() <= 160
        && data.subjectNameEn is string && data.subjectNameEn.size() >= 1 && data.subjectNameEn.size() <= 160
        && data.fullMarks is number && data.fullMarks > 0 && data.fullMarks <= 500
        && data.passMarks is number && data.passMarks >= 0 && data.passMarks <= data.fullMarks
        && data.isOptional is bool
        && data.hasComponents is bool
        && data.hasPractical is bool
        && isOptionalNullableNumber(data, 'writtenFullMarks', 0, 500)
        && isOptionalNullableNumber(data, 'mcqFullMarks', 0, 500)
        && isOptionalNullableNumber(data, 'practicalFullMarks', 0, 500)
        && isOptionalNullableNumber(data, 'writtenMarks', 0, 500)
        && isOptionalNullableNumber(data, 'mcqMarks', 0, 500)
        && isOptionalNullableNumber(data, 'practicalMarks', 0, 500)
        && data.obtainedMarks is number && data.obtainedMarks >= 0 && data.obtainedMarks <= data.fullMarks
        && data.isAbsent is bool
        && data.letterGrade is string && data.letterGrade.size() >= 1 && data.letterGrade.size() <= 10
        && data.gradePoint is number && data.gradePoint >= 0 && data.gradePoint <= 10
        && data.isPassed is bool
        && data.displayOrder is number
        && data.isPublished is bool
        && data.updatedAt == request.time;
    }

    // =========================================================================
    // Phase 3 BPSC Cloud Document Center Validation Blueprint
    // =========================================================================

    function isValidCloudDocument(data) {
      return data.keys().hasAll([
          'title',
          'category',
          'className',
          'subject',
          'academicYear',
          'description',
          'driveUrl',
          'fileType',
          'fileSize',
          'isPublished',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'title',
          'titleBn',
          'category',
          'className',
          'subject',
          'academicYear',
          'description',
          'descriptionBn',
          'driveUrl',
          'fileType',
          'fileSize',
          'isPublished',
          'isDemoRecord',
          'createdAt',
          'updatedAt'
        ])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 250
        && isOptionalString(data, 'titleBn', 250)
        && data.category is string && data.category in [
          'Class Routine',
          'Exam Routine',
          'Syllabus',
          'Office Notice',
          'Office Order',
          'Forms',
          'Academic Calendar',
          'Holiday List',
          'Question Papers',
          'Model Questions',
          'Study Materials',
          'Other Documents'
        ]
        && (
          data.className == null || (
            data.className is string && data.className in [
              'Nursery',
              'Class 1',
              'Class 2',
              'Class 3',
              'Class 4',
              'Class 5',
              'Class 6',
              'Class 7',
              'Class 8',
              'Class 9',
              'Class 10'
            ]
          )
        )
        && (data.subject == null || (data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 120))
        && (
          data.academicYear == null || (
            data.academicYear is string
            && data.academicYear.size() >= 4
            && data.academicYear.size() <= 20
            && data.academicYear.matches('^[0-9]{4}(-[0-9]{2,4})?$')
          )
        )
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 2000
        && isOptionalString(data, 'descriptionBn', 2000)
        && data.driveUrl is string
        && data.driveUrl.size() >= 24
        && data.driveUrl.size() <= 600
        && data.driveUrl.matches('^https://(drive|docs)\\.google\\.com/[a-zA-Z0-9_\\-./?=&%+]+$')
        && data.fileType is string && data.fileType in [
          'PDF',
          'DOC',
          'DOCX',
          'XLS',
          'XLSX',
          'PPT',
          'PPTX',
          'JPG',
          'PNG',
          'ZIP',
          'OTHER'
        ]
        && (data.fileSize == null || (data.fileSize is string && data.fileSize.size() >= 1 && data.fileSize.size() <= 40))
        && data.isPublished is bool
        && (!('isDemoRecord' in data) || data.isDemoRecord is bool)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    // =========================================================================
    // Phase 1 & Phase 4 Institutional Collection Match Rules
    // =========================================================================

    match /siteContent/{contentId} {
      allow get: if isValidId(contentId) && (existing().isPublished == true || isAdmin());
      allow list: if existing().isPublished == true || isAdmin();
      allow create: if isSignedIn() && isValidId(contentId) && isValidSiteContent(incoming()) && canManageWebsiteContent();
      allow update: if isSignedIn() && isValidId(contentId) && isValidSiteContent(incoming()) && incoming().sectionKey == existing().sectionKey && canManageWebsiteContent();
      allow delete: if isSignedIn() && isValidId(contentId) && canManageWebsiteContent();
    }

    match /banners/{bannerId} {
      allow get: if isValidId(bannerId) && (existing().isPublished == true || isAdmin());
      allow list: if existing().isPublished == true || isAdmin();
      allow create: if isSignedIn() && isValidId(bannerId) && isValidBanner(incoming()) && canManageWebsiteContent();
      allow update: if isSignedIn() && isValidId(bannerId) && isValidBanner(incoming()) && canManageWebsiteContent();
      allow delete: if isSignedIn() && isValidId(bannerId) && canManageWebsiteContent();
    }

    match /administration/{memberId} {
      allow get: if isValidId(memberId) && (existing().isPublished == true || isAdmin());
      allow list: if existing().isPublished == true || isAdmin();
      allow create: if isSignedIn() && isValidId(memberId) && isValidAdminMember(incoming()) && canManageWebsiteContent();
      allow update: if isSignedIn() && isValidId(memberId) && isValidAdminMember(incoming()) && canManageWebsiteContent();
      allow delete: if isSignedIn() && isValidId(memberId) && canManageWebsiteContent();
    }

    match /governingBody/{memberId} {
      allow get: if isValidId(memberId) && (existing().isPublished == true || isAdmin());
      allow list: if existing().isPublished == true || isAdmin();
      allow create: if isSignedIn() && isValidId(memberId) && isValidGoverningBodyMember(incoming()) && canManageWebsiteContent();
      allow update: if isSignedIn() && isValidId(memberId) && isValidGoverningBodyMember(incoming()) && canManageWebsiteContent();
      allow delete: if isSignedIn() && isValidId(memberId) && canManageWebsiteContent();
    }

    match /teachers/{teacherId} {
      allow get: if isValidId(teacherId) && (existing().isPublished == true || isAdmin());
      allow list: if existing().isPublished == true || isAdmin();
      allow create: if isSignedIn() && isValidId(teacherId) && isValidTeacher(incoming()) && canManageTeachersAndAccess();
      allow update: if isSignedIn() && isValidId(teacherId) && isValidTeacher(incoming()) && canManageTeachersAndAccess();
      allow delete: if isSignedIn() && isValidId(teacherId) && canManageTeachersAndAccess();
    }

    match /staff/{staffId} {
      allow get: if isValidId(staffId) && (existing().isPublished == true || isAdmin());
      allow list: if existing().isPublished == true || isAdmin();
      allow create: if isSignedIn() && isValidId(staffId) && isValidStaffMember(incoming()) && canManageTeachersAndAccess();
      allow update: if isSignedIn() && isValidId(staffId) && isValidStaffMember(incoming()) && canManageTeachersAndAccess();
      allow delete: if isSignedIn() && isValidId(staffId) && canManageTeachersAndAccess();
    }

    match /classes/{classId} {
      allow get: if isValidId(classId) && (existing().isPublished == true || isAdmin());
      allow list: if existing().isPublished == true || isAdmin();
      allow create: if isSignedIn() && isValidId(classId) && isValidAcademicClass(incoming()) && canManageWebsiteContent();
      allow update: if isSignedIn() && isValidId(classId) && isValidAcademicClass(incoming()) && incoming().classCode == existing().classCode && canManageWebsiteContent();
      allow delete: if isSignedIn() && isValidId(classId) && canManageWebsiteContent();
    }

    match /academicResources/{resourceId} {
      allow get: if isValidId(resourceId) && (existing().isPublished == true || isAdmin());
      allow list: if existing().isPublished == true || isAdmin();
      allow create: if isSignedIn() && isValidId(resourceId) && isValidAcademicResource(incoming()) && canManageCloud();
      allow update: if isSignedIn() && isValidId(resourceId) && isValidAcademicResource(incoming()) && canManageCloud();
      allow delete: if isSignedIn() && isValidId(resourceId) && canManageCloud();
    }

    match /notices/{noticeId} {
      allow get: if isValidId(noticeId) && (existing().isPublished == true || isAdmin());
      allow list: if existing().isPublished == true || isAdmin();
      allow create: if isSignedIn() && isValidId(noticeId) && isValidNotice(incoming()) && canManageNoticesAndHolidays();
      allow update: if isSignedIn() && isValidId(noticeId) && isValidNotice(incoming()) && canManageNoticesAndHolidays();
      allow delete: if isSignedIn() && isValidId(noticeId) && canManageNoticesAndHolidays();
    }

    match /gallery/{itemId} {
      allow get: if isValidId(itemId) && (existing().isPublished == true || isAdmin());
      allow list: if existing().isPublished == true || isAdmin();
      allow create: if isSignedIn() && isValidId(itemId) && isValidGalleryItem(incoming()) && canManageWebsiteContent();
      allow update: if isSignedIn() && isValidId(itemId) && isValidGalleryItem(incoming()) && canManageWebsiteContent();
      allow delete: if isSignedIn() && isValidId(itemId) && canManageWebsiteContent();
    }

    match /news/{newsId} {
      allow get: if isValidId(newsId) && (existing().isPublished == true || isAdmin());
      allow list: if existing().isPublished == true || isAdmin();
      allow create: if isSignedIn() && isValidId(newsId) && isValidNewsItem(incoming()) && canManageWebsiteContent();
      allow update: if isSignedIn() && isValidId(newsId) && isValidNewsItem(incoming()) && canManageWebsiteContent();
      allow delete: if isSignedIn() && isValidId(newsId) && canManageWebsiteContent();
    }

    match /events/{eventId} {
      allow get: if isValidId(eventId) && (existing().isPublished == true || isAdmin());
      allow list: if existing().isPublished == true || isAdmin();
      allow create: if isSignedIn() && isValidId(eventId) && isValidEventItem(incoming()) && canManageWebsiteContent();
      allow update: if isSignedIn() && isValidId(eventId) && isValidEventItem(incoming()) && canManageWebsiteContent();
      allow delete: if isSignedIn() && isValidId(eventId) && canManageWebsiteContent();
    }

    match /facilities/{facilityId} {
      allow get: if isValidId(facilityId) && (existing().isPublished == true || isAdmin());
      allow list: if existing().isPublished == true || isAdmin();
      allow create: if isSignedIn() && isValidId(facilityId) && isValidFacility(incoming()) && canManageWebsiteContent();
      allow update: if isSignedIn() && isValidId(facilityId) && isValidFacility(incoming()) && canManageWebsiteContent();
      allow delete: if isSignedIn() && isValidId(facilityId) && canManageWebsiteContent();
    }

    match /transport/{transportId} {
      allow get: if isValidId(transportId) && (existing().isPublished == true || isAdmin());
      allow list: if existing().isPublished == true || isAdmin();
      allow create: if isSignedIn() && isValidId(transportId) && isValidTransportInfo(incoming()) && canManageWebsiteContent();
      allow update: if isSignedIn() && isValidId(transportId) && isValidTransportInfo(incoming()) && canManageWebsiteContent();
      allow delete: if isSignedIn() && isValidId(transportId) && canManageWebsiteContent();
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId) && (existing().isPublished == true || isAdmin());
      allow list: if existing().isPublished == true || isAdmin();
      allow create: if isSignedIn() && isValidId(settingId) && isValidSiteSetting(incoming()) && canManageSettings();
      allow update: if isSignedIn() && isValidId(settingId) && isValidSiteSetting(incoming()) && canManageSettings();
      allow delete: if isSignedIn() && isValidId(settingId) && canManageSettings();
    }

    match /contactMessages/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId) && canManageWebsiteContent();
      allow list: if canManageWebsiteContent();
      allow create: if isValidId(messageId)
        && isValidContactMessage(incoming())
        && incoming().status == 'new'
        && incoming().createdAt == request.time;
      allow update: if isSignedIn()
        && isValidId(messageId)
        && isValidContactMessage(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        && canManageWebsiteContent();
      allow delete: if isSignedIn() && isValidId(messageId) && canManageWebsiteContent();
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() && isValidId(adminId) && isValidLegacyAdminUser(incoming()) && incoming().createdAt == request.time;
      allow update: if isSuperAdmin()
        && isValidId(adminId)
        && isValidLegacyAdminUser(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().email == existing().email
        && incoming().diff(existing()).affectedKeys().hasOnly(['role']);
      allow delete: if isSuperAdmin() && isValidId(adminId);
    }

    // =========================================================================
    // Phase 4 Master Admin Panel RBAC, Holidays, Teacher Requests & Audit Rules
    // =========================================================================

    match /adminUsers/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(uid)
        && isValidAdminUserRecord(incoming())
        && incoming().uid == uid
        && incoming().createdAt == request.time
        && isSuperAdmin();
      allow update: if isSignedIn()
        && isValidId(uid)
        && isValidAdminUserRecord(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && isSuperAdmin();
      allow delete: if isSignedIn() && isValidId(uid) && isSuperAdmin();
    }

    match /schoolSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(settingId)
        && isValidSchoolOperationalSetting(incoming())
        && canManageSettings();
      allow update: if isSignedIn()
        && isValidId(settingId)
        && isValidSchoolOperationalSetting(incoming())
        && canManageSettings();
      allow delete: if isSignedIn() && isValidId(settingId) && canManageSettings();
    }

    match /holidays/{holidayId} {
      allow get: if isValidId(holidayId) && (existing().isPublished == true || isAdmin());
      allow list: if existing().isPublished == true || isAdmin();
      allow create: if isSignedIn()
        && isValidId(holidayId)
        && isValidHoliday(incoming())
        && incoming().createdAt == request.time
        && canManageNoticesAndHolidays();
      allow update: if isSignedIn()
        && isValidId(holidayId)
        && isValidHoliday(incoming())
        && incoming().createdAt == existing().createdAt
        && canManageNoticesAndHolidays();
      allow delete: if isSignedIn() && isValidId(holidayId) && canManageNoticesAndHolidays();
    }

    match /teacherAccessRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (
        canManageTeachersAndAccess()
        || existing().applicantUid == request.auth.uid
      );
      allow list: if canManageTeachersAndAccess() || (isSignedIn() && existing().applicantUid == request.auth.uid);
      allow create: if isSignedIn()
        && isValidId(requestId)
        && isValidTeacherAccessRequest(incoming())
        && incoming().createdAt == request.time
        && (
          canManageTeachersAndAccess()
          || (incoming().applicantUid == request.auth.uid && incoming().status == 'pending')
        );
      allow update: if isSignedIn()
        && isValidId(requestId)
        && isValidTeacherAccessRequest(incoming())
        && incoming().createdAt == existing().createdAt
        && canManageTeachersAndAccess();
      allow delete: if isSignedIn() && isValidId(requestId) && canManageTeachersAndAccess();
    }

    match /activityLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && isValidId(logId)
        && isValidActivityLog(incoming())
        && isAdmin();
      allow update, delete: if false;
    }

    // =========================================================================
    // Phase 2 Result Portal & Result Management Match Rules
    // =========================================================================

    match /authorizedTeachers/{teacherUid} {
      allow get: if isSignedIn() && isValidId(teacherUid) && (request.auth.uid == teacherUid || isAdmin() || isAuthorizedTeacher());
      allow list: if canManageTeachersAndAccess() || isAuthorizedTeacher();
      allow create: if isSignedIn()
        && isValidId(teacherUid)
        && isValidAuthorizedTeacher(incoming())
        && incoming().createdAt == request.time
        && canManageTeachersAndAccess();
      allow update: if isSignedIn()
        && isValidId(teacherUid)
        && isValidAuthorizedTeacher(incoming())
        && incoming().createdAt == existing().createdAt
        && (
          canManageTeachersAndAccess()
          || (
            request.auth.uid == teacherUid
            && existing().isActive == true
            && incoming().isActive == existing().isActive
            && incoming().email == existing().email
            && incoming().teacherId == existing().teacherId
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'phone',
              'photoUrl',
              'bio',
              'officeHours',
              'qualification',
              'updatedAt'
            ])
          )
        );
      allow delete: if isSignedIn() && isValidId(teacherUid) && canManageTeachersAndAccess();
    }

    match /academicYears/{yearId} {
      allow get: if isValidId(yearId) && (existing().isActive == true || isAdmin());
      allow list: if existing().isActive == true || isAdmin();
      allow create: if isSignedIn() && isValidId(yearId) && isValidAcademicYear(incoming()) && canManageResults();
      allow update: if isSignedIn()
        && isValidId(yearId)
        && isValidAcademicYear(incoming())
        && incoming().yearCode == existing().yearCode
        && canManageResults();
      allow delete: if isSignedIn() && isValidId(yearId) && canManageResults();
    }

    match /examinations/{examId} {
      allow get: if isValidId(examId) && (existing().isActive == true || isAdmin());
      allow list: if existing().isActive == true || isAdmin();
      allow create: if isSignedIn()
        && isValidId(examId)
        && isValidExamination(incoming())
        && incoming().createdAt == request.time
        && (canManageResults() && (isBootstrappedAdmin() || exists(/databases/$(database)/documents/academicYears/$(incoming().academicYearId))));
      allow update: if isSignedIn()
        && isValidId(examId)
        && isValidExamination(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().academicYearId == existing().academicYearId
        && canManageResults();
      allow delete: if isSignedIn() && isValidId(examId) && canManageResults();
    }

    // Student Enrollment Records (Admins manage all; authorized teachers can view students of their assigned classes)
    match /students/{studentId} {
      allow get: if isSignedIn() && isValidId(studentId) && (
        canManageStudents()
        || (
          isAuthorizedTeacher()
          && exists(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid))
          && (get(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid)).data.canViewStudents != false)
          && (resource.data.classCode in get(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid)).data.assignedClasses)
        )
      );
      allow list: if canManageStudents()
        || (
          isAuthorizedTeacher()
          && exists(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid))
          && (get(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid)).data.canViewStudents != false)
        );
      allow create: if isSignedIn()
        && isValidId(studentId)
        && isValidStudent(incoming())
        && canManageStudents();
      allow update: if isSignedIn()
        && isValidId(studentId)
        && isValidStudent(incoming())
        && incoming().academicYearId == existing().academicYearId
        && incoming().rollNumber == existing().rollNumber
        && canManageStudents();
      allow delete: if isSignedIn() && isValidId(studentId) && canManageStudents();
    }

    match /subjects/{subjectId} {
      allow get: if isValidId(subjectId) && (existing().isActive == true || isAdmin() || isAuthorizedTeacher());
      allow list: if existing().isActive == true || isAdmin() || isAuthorizedTeacher();
      allow create: if isSignedIn() && isValidId(subjectId) && isValidSubjectConfig(incoming()) && canManageResults();
      allow update: if isSignedIn()
        && isValidId(subjectId)
        && isValidSubjectConfig(incoming())
        && incoming().subjectCode == existing().subjectCode
        && incoming().classCode == existing().classCode
        && canManageResults();
      allow delete: if isSignedIn() && isValidId(subjectId) && canManageResults();
    }

    match /gradingRules/{ruleId} {
      allow get: if isValidId(ruleId) && (existing().isActive == true || isAdmin() || isAuthorizedTeacher());
      allow list: if existing().isActive == true || isAdmin() || isAuthorizedTeacher();
      allow create: if isSignedIn() && isValidId(ruleId) && isValidGradingRule(incoming()) && canManageResults();
      allow update: if isSignedIn()
        && isValidId(ruleId)
        && isValidGradingRule(incoming())
        && incoming().ruleCode == existing().ruleCode
        && canManageResults();
      allow delete: if isSignedIn() && isValidId(ruleId) && canManageResults();
    }

    // Class-Exam Publication Status Gate (Contains zero student PII/marks; Teachers can ONLY submit drafts, NEVER publish)
    match /resultPublication/{publicationId} {
      allow get: if isValidId(publicationId) && (resource == null || existing().isActive == true || isAdmin() || isAuthorizedTeacher());
      allow list: if existing().isActive == true || canManageResults() || isAuthorizedTeacher();
      allow create: if isSignedIn()
        && isValidId(publicationId)
        && isValidResultPublication(incoming())
        && (
          canManageResults() || (
            isAuthorizedTeacher()
            && exists(/databases/$(database)/documents/academicYears/$(incoming().academicYearId))
            && exists(/databases/$(database)/documents/examinations/$(incoming().examId))
            && incoming().isPublished == false
            && incoming().workflowStatus in ['draft', 'submitted']
          )
        );
      allow update: if isSignedIn()
        && isValidId(publicationId)
        && isValidResultPublication(incoming())
        && incoming().academicYearId == existing().academicYearId
        && incoming().examId == existing().examId
        && incoming().classCode == existing().classCode
        && (
          (
            existing().isPublished == false
            && existing().workflowStatus in ['draft', 'rejected', 'submitted']
            && incoming().isPublished == false
            && incoming().workflowStatus == 'submitted'
            && incoming().diff(existing()).affectedKeys().hasOnly(['workflowStatus', 'isPublished', 'updatedAt'])
            && isAuthorizedTeacher()
          )
          || canManageResults()
        );
      allow delete: if isSignedIn() && isValidId(publicationId) && canManageResults();
    }

    // Student Examination Results (Public read strictly locked to workflowStatus == 'published' && isPublished == true)
    match /results/{resultId} {
      allow get: if isValidId(resultId) && (
        (existing().isPublished == true && existing().workflowStatus == 'published')
        || canManageResults()
        || (isAuthorizedTeacher() && existing().enteredByUid == request.auth.uid)
      );
      allow list: if (existing().isPublished == true && existing().workflowStatus == 'published')
        || (isSignedIn() && existing().enteredByUid == request.auth.uid)
        || canManageResults();
      allow create: if isSignedIn()
        && isValidId(resultId)
        && isValidStudentResult(incoming())
        && incoming().enteredByUid == request.auth.uid
        && (
          canManageResults() || (
            isAuthorizedTeacher()
            && exists(/databases/$(database)/documents/academicYears/$(incoming().academicYearId))
            && exists(/databases/$(database)/documents/examinations/$(incoming().examId))
            && incoming().isPublished == false
            && incoming().workflowStatus == 'draft'
          )
        );
      allow update: if isSignedIn()
        && isValidId(resultId)
        && isValidStudentResult(incoming())
        && incoming().academicYearId == existing().academicYearId
        && incoming().examId == existing().examId
        && incoming().classCode == existing().classCode
        && incoming().rollNumber == existing().rollNumber
        && incoming().studentId == existing().studentId
        && (
          (
            existing().isPublished == false
            && existing().workflowStatus in ['draft', 'rejected']
            && incoming().enteredByUid == existing().enteredByUid
            && existing().enteredByUid == request.auth.uid
            && incoming().isPublished == false
            && incoming().workflowStatus in ['draft', 'submitted']
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'studentNameEn',
              'studentNameBn',
              'section',
              'groupNameEn',
              'groupNameBn',
              'gradingRuleId',
              'totalFullMarks',
              'obtainedTotalMarks',
              'percentage',
              'gpa',
              'gpaWithoutOptional',
              'calculateGpa',
              'calculatePercentage',
              'maxGpa',
              'letterGrade',
              'finalStatus',
              'compulsorySubjectCount',
              'failedCompulsoryCount',
              'position',
              'showPosition',
              'workflowStatus',
              'isPublished',
              'updatedAt'
            ])
            && isAuthorizedTeacher()
          )
          || canManageResults()
        );
      allow delete: if isSignedIn() && isValidId(resultId) && canManageResults();
    }

    // Subject-Wise Marksheet Rows (Public read strictly locked to isPublished == true)
    match /resultSubjects/{resultSubjectId} {
      allow get: if isValidId(resultSubjectId) && (
        existing().isPublished == true
        || canManageResults()
        || (
          isAuthorizedTeacher()
          && get(/databases/$(database)/documents/results/$(existing().resultId)).data.enteredByUid == request.auth.uid
        )
      );
      allow list: if existing().isPublished == true || canManageResults();
      allow create: if isSignedIn()
        && isValidId(resultSubjectId)
        && isValidResultSubject(incoming())
        && existsAfter(/databases/$(database)/documents/results/$(incoming().resultId))
        && (
          canManageResults() || (
            isAuthorizedTeacher()
            && incoming().isPublished == false
            && getAfter(/databases/$(database)/documents/results/$(incoming().resultId)).data.isPublished == false
            && getAfter(/databases/$(database)/documents/results/$(incoming().resultId)).data.enteredByUid == request.auth.uid
          )
        );
      allow update: if isSignedIn()
        && isValidId(resultSubjectId)
        && isValidResultSubject(incoming())
        && incoming().resultId == existing().resultId
        && incoming().academicYearId == existing().academicYearId
        && incoming().examId == existing().examId
        && incoming().classCode == existing().classCode
        && incoming().rollNumber == existing().rollNumber
        && incoming().subjectCode == existing().subjectCode
        && (
          (
            existing().isPublished == false
            && incoming().isPublished == false
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'fullMarks',
              'passMarks',
              'writtenFullMarks',
              'mcqFullMarks',
              'practicalFullMarks',
              'writtenMarks',
              'mcqMarks',
              'practicalMarks',
              'obtainedMarks',
              'isAbsent',
              'letterGrade',
              'gradePoint',
              'isPassed',
              'displayOrder',
              'updatedAt'
            ])
            && isAuthorizedTeacher()
            && get(/databases/$(database)/documents/results/$(existing().resultId)).data.isPublished == false
            && get(/databases/$(database)/documents/results/$(existing().resultId)).data.workflowStatus in ['draft', 'rejected']
            && get(/databases/$(database)/documents/results/$(existing().resultId)).data.enteredByUid == request.auth.uid
          )
          || canManageResults()
        );
      allow delete: if isSignedIn() && isValidId(resultSubjectId) && canManageResults();
    }

    // =========================================================================
    // Phase 3 BPSC Cloud Document Center Match Rules
    // =========================================================================
    match /cloudDocuments/{documentId} {
      allow get: if isValidId(documentId) && (existing().isPublished == true || canManageCloud() || isAdmin());
      allow list: if existing().isPublished == true || canManageCloud() || isAdmin();
      allow create: if isSignedIn()
        && isValidId(documentId)
        && isValidCloudDocument(incoming())
        && incoming().createdAt == request.time
        && canManageCloud();
      allow update: if isSignedIn()
        && isValidId(documentId)
        && isValidCloudDocument(incoming())
        && incoming().createdAt == existing().createdAt
        && canManageCloud();
      allow delete: if isSignedIn() && isValidId(documentId) && canManageCloud();
    }

    // =========================================================================
    // Phase 5 Teacher Panel Collections: Mark Submissions & Attendance Records
    // =========================================================================
    match /teacherMarkSubmissions/{submissionId} {
      allow get: if isSignedIn() && isValidId(submissionId) && (
        canManageResults()
        || existing().teacherUid == request.auth.uid
        || (
          isAuthorizedTeacher()
          && exists(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid))
          && get(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid)).data.classTeacherOf == existing().classCode
        )
      );
      allow list: if canManageResults() || (isSignedIn() && isAuthorizedTeacher());
      allow create: if isSignedIn()
        && isValidId(submissionId)
        && isValidTeacherMarkSubmission(incoming())
        && incoming().teacherUid == request.auth.uid
        && (
          canManageResults()
          || (
            isAuthorizedTeacher()
            && exists(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid))
            && (incoming().classCode in get(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid)).data.assignedClasses)
          )
        );
      allow update: if isSignedIn()
        && isValidId(submissionId)
        && isValidTeacherMarkSubmission(incoming())
        && incoming().createdAt == existing().createdAt
        && (
          canManageResults()
          || (
            isAuthorizedTeacher()
            && existing().teacherUid == request.auth.uid
            && existing().status in ['draft', 'rejected']
            && incoming().status in ['draft', 'submitted']
          )
        );
      allow delete: if isSignedIn()
        && isValidId(submissionId)
        && (
          canManageResults()
          || (
            isAuthorizedTeacher()
            && existing().teacherUid == request.auth.uid
            && existing().status == 'draft'
          )
        );
    }

    match /attendanceRecords/{attendanceId} {
      allow get: if isSignedIn() && isValidId(attendanceId) && (
        isAdmin()
        || (
          isAuthorizedTeacher()
          && exists(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid))
          && (existing().classCode in get(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid)).data.assignedClasses)
        )
      );
      allow list: if isAdmin() || (isSignedIn() && isAuthorizedTeacher());
      allow create: if isSignedIn()
        && isValidId(attendanceId)
        && isValidAttendanceRecord(incoming())
        && incoming().teacherUid == request.auth.uid
        && (
          isAdmin()
          || (
            isAuthorizedTeacher()
            && exists(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid))
            && get(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid)).data.canTakeAttendance != false
            && (incoming().classCode in get(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid)).data.assignedClasses)
          )
        );
      allow update: if isSignedIn()
        && isValidId(attendanceId)
        && isValidAttendanceRecord(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().classCode == existing().classCode
        && incoming().date == existing().date
        && (
          isAdmin()
          || (
            isAuthorizedTeacher()
            && existing().teacherUid == request.auth.uid
            && exists(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid))
            && get(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid)).data.canTakeAttendance != false
          )
        );
      allow delete: if isSignedIn()
        && isValidId(attendanceId)
        && (
          isAdmin()
          || (
            isAuthorizedTeacher()
            && existing().teacherUid == request.auth.uid
          )
        );
    }
  }
}

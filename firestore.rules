rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Boot Connection Health Check
    match /test/{docId} {
      allow get: if docId == 'connection';
    }

    // =========================================================================
    // Global Hardened Primitives & Phase 4 RBAC Helpers
    // =========================================================================

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return request.auth != null
        && (request.auth.token.email == 'tofayel.tllt@gmail.com' || request.auth.token.email == 'labib87691@gmail.com')
        && request.auth.token.email_verified == true;
    }

    function hasActiveAdminRole(allowedRoles) {
      return isBootstrappedAdmin() || (
        isSignedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.isActive == true
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role in allowedRoles
      ) || (
        isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSuperAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.isActive == true
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    function isAdmin() {
      return hasActiveAdminRole([
        'super_admin',
        'admin',
        'result_manager',
        'cloud_manager',
        'content_editor'
      ]);
    }

    function canManageWebsiteContent() {
      return hasActiveAdminRole(['super_admin', 'admin', 'content_editor']);
    }

    function canManageCloud() {
      return hasActiveAdminRole(['super_admin', 'admin', 'cloud_manager']);
    }

    function canManageResults() {
      return hasActiveAdminRole(['super_admin', 'admin', 'result_manager']);
    }

    function canManageStudents() {
      return hasActiveAdminRole(['super_admin', 'admin', 'result_manager']);
    }

    function canManageTeachersAndAccess() {
      return hasActiveAdminRole(['super_admin', 'admin']);
    }

    function canManageNoticesAndHolidays() {
      return hasActiveAdminRole(['super_admin', 'admin', 'cloud_manager', 'content_editor']);
    }

    function canManageSettings() {
      return hasActiveAdminRole(['super_admin', 'admin']);
    }

    function isAuthorizedTeacher() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid))
        && get(/databases/$(database)/documents/authorizedTeachers/$(request.auth.uid)).data.isActive == true;
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptionalNullableString(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptionalNullableNumber(data, field, minVal, maxVal) {
      return !(field in data) || data[field] == null || (data[field] is number && data[field] >= minVal && data[field] <= maxVal);
    }

    function isOptionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    function isValidSupportedClassCode(code) {
      return code is string && code in [
        'nursery',
        'class-1',
        'class-2',
        'class-3',
        'class-4',
        'class-5',
        'class-6',
        'class-7',
        'class-8',
        'class-9',
        'class-10'
      ];
    }

    // =========================================================================
    // Phase 1 & Phase 4 Institutional Entity Validation Blueprints
    // =========================================================================

    function isValidSiteContent(data) {
      return data.keys().hasAll(['sectionKey', 'titleBn', 'titleEn', 'bodyBn', 'bodyEn', 'isPublished', 'updatedAt'])
        && data.keys().hasOnly(['sectionKey', 'titleBn', 'titleEn', 'bodyBn', 'bodyEn', 'isPublished', 'updatedAt'])
        && data.sectionKey is string && data.sectionKey.size() >= 1 && data.sectionKey.size() <= 80 && data.sectionKey.matches('^[a-zA-Z0-9_\\-]+$')
        && data.titleBn is string && data.titleBn.size() >= 1 && data.titleBn.size() <= 300
        && data.titleEn is string && data.titleEn.size() >= 1 && data.titleEn.size() <= 300
        && data.bodyBn is string && data.bodyBn.size() >= 1 && data.bodyBn.size() <= 10000
        && data.bodyEn is string && data.bodyEn.size() >= 1 && data.bodyEn.size() <= 10000
        && data.isPublished is bool
        && data.updatedAt == request.time;
    }

    function isValidBanner(data) {
      return data.keys().hasAll(['titleBn', 'titleEn', 'imageUrl', 'order', 'isPublished'])
        && data.keys().hasOnly(['titleBn', 'titleEn', 'subtitleBn', 'subtitleEn', 'imageUrl', 'order', 'isPublished', 'createdAt', 'updatedAt'])
        && data.titleBn is string && data.titleBn.size() >= 1 && data.titleBn.size() <= 200
        && data.titleEn is string && data.titleEn.size() >= 1 && data.titleEn.size() <= 200
        && isOptionalString(data, 'subtitleBn', 500)
        && isOptionalString(data, 'subtitleEn', 500)
        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 600
        && data.order is number
        && data.isPublished is bool
        && isOptionalTimestamp(data, 'createdAt')
        && isOptionalTimestamp(data, 'updatedAt');
    }

    function isValidAdminMember(data) {
      return data.keys().hasAll(['roleKey', 'name', 'designationBn', 'designationEn', 'order', 'isPublished'])
        && data.keys().hasOnly([
          'roleKey',
          'name',
          'nameBn',
          'credentials',
          'designationBn',
          'designationEn',
          'organizationBn',
          'organizationEn',
          'messageBn',
          'messageEn',
          'photoUrl',
          'phone',
          'email',
          'order',
          'isPublished',
          'updatedAt'
        ])
        && data.roleKey is string && data.roleKey.size() >= 1 && data.roleKey.size() <= 60 && data.roleKey.matches('^[a-zA-Z0-9_\\-]+$')
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && isOptionalString(data, 'nameBn', 200)
        && isOptionalString(data, 'credentials', 200)
        && data.designationBn is string && data.designationBn.size() >= 1 && data.designationBn.size() <= 300
        && data.designationEn is string && data.designationEn.size() >= 1 && data.designationEn.size() <= 300
        && isOptionalString(data, 'organizationBn', 300)
        && isOptionalString(data, 'organizationEn', 300)
        && isOptionalString(data, 'messageBn', 8000)
        && isOptionalString(data, 'messageEn', 8000)
        && isOptionalString(data, 'photoUrl', 600)
        && isOptionalString(data, 'phone', 40)
        && isOptionalString(data, 'email', 160)
        && data.order is number
        && data.isPublished is bool
        && isOptionalTimestamp(data, 'updatedAt');
    }

    function isValidGoverningBodyMember(data) {
      return data.keys().hasAll(['name', 'boardRoleBn', 'boardRoleEn', 'designationBn', 'designationEn', 'order', 'isPublished'])
        && data.keys().hasOnly([
          'name',
          'nameBn',
          'boardRoleBn',
          'boardRoleEn',
          'designationBn',
          'designationEn',
          'photoUrl',
          'photoMissingNote',
          'order',
          'isPublished',
          'updatedAt'
        ])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && isOptionalString(data, 'nameBn', 200)
        && data.boardRoleBn is string && data.boardRoleBn.size() >= 1 && data.boardRoleBn.size() <= 200
        && data.boardRoleEn is string && data.boardRoleEn.size() >= 1 && data.boardRoleEn.size() <= 200
        && data.designationBn is string && data.designationBn.size() >= 1 && data.designationBn.size() <= 300
        && data.designationEn is string && data.designationEn.size() >= 1 && data.designationEn.size() <= 300
        && isOptionalString(data, 'photoUrl', 600)
        && isOptionalString(data, 'photoMissingNote', 200)
        && data.order is number
        && data.isPublished is bool
        && isOptionalTimestamp(data, 'updatedAt');
    }

    function isValidTeacher(data) {
      return data.keys().hasAll(['serial', 'name', 'designationBn', 'designationEn', 'department', 'subjectBn', 'subjectEn', 'isPublished'])
        && data.keys().hasOnly([
          'serial',
          'name',
          'nameBn',
          'designationBn',
          'designationEn',
          'department',
          'departmentBn',
          'subjectBn',
          'subjectEn',
          'qualification',
          'photoUrl',
          'publicEmail',
          'publicPhone',
          'assignedClass',
          'assignedSection',
          'coordinatorRoleBn',
          'coordinatorRoleEn',
          'employmentStatus',
          'isActive',
          'isPublished',
          'updatedAt'
        ])
        && data.serial is number
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && isOptionalString(data, 'nameBn', 200)
        && data.designationBn is string && data.designationBn.size() >= 1 && data.designationBn.size() <= 250
        && data.designationEn is string && data.designationEn.size() >= 1 && data.designationEn.size() <= 250
        && data.department is string && data.department.size() >= 1 && data.department.size() <= 120
        && isOptionalString(data, 'departmentBn', 160)
        && data.subjectBn is string && data.subjectBn.size() >= 1 && data.subjectBn.size() <= 200
        && data.subjectEn is string && data.subjectEn.size() >= 1 && data.subjectEn.size() <= 200
        && isOptionalString(data, 'qualification', 600)
        && isOptionalString(data, 'photoUrl', 600)
        && isOptionalString(data, 'publicEmail', 160)
        && isOptionalString(data, 'publicPhone', 60)
        && isOptionalString(data, 'assignedClass', 60)
        && isOptionalString(data, 'assignedSection', 40)
        && isOptionalString(data, 'coordinatorRoleBn', 160)
        && isOptionalString(data, 'coordinatorRoleEn', 160)
        && (!('employmentStatus' in data) || data.employmentStatus in ['active', 'on_leave', 'inactive'])
        && (!('isActive' in data) || data.isActive is bool)
        && data.isPublished is bool
        && isOptionalTimestamp(data, 'updatedAt');
    }

    function isValidStaffMember(data) {
      return data.keys().hasAll(['serial', 'name', 'designationBn', 'designationEn', 'isPublished'])
        && data.keys().hasOnly([
          'serial',
          'name',
          'nameBn',
          'designationBn',
          'designationEn',
          'photoUrl',
          'publicPhone',
          'publicEmail',
          'employmentStatus',
          'isActive',
          'isPublished',
          'updatedAt'
        ])
        && data.serial is number
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && isOptionalString(data, 'nameBn', 200)
        && data.designationBn is string && data.designationBn.size() >= 1 && data.designationBn.size() <= 200
        && data.designationEn is string && data.designationEn.size() >= 1 && data.designationEn.size() <= 200
        && isOptionalString(data, 'photoUrl', 600)
        && isOptionalString(data, 'publicPhone', 60)
        && isOptionalString(data, 'publicEmail', 160)
        && (!('employmentStatus' in data) || data.employmentStatus in ['active', 'on_leave', 'inactive'])
        && (!('isActive' in data) || data.isActive is bool)
        && data.isPublished is bool
        && isOptionalTimestamp(data, 'updatedAt');
    }

    function isValidAcademicClass(data) {
      return data.keys().hasAll(['levelOrder', 'classCode', 'nameBn', 'nameEn', 'sectionGroupBn', 'sectionGroupEn', 'descriptionBn', 'descriptionEn', 'isPublished'])
        && data.keys().hasOnly(['levelOrder', 'classCode', 'nameBn', 'nameEn', 'sectionGroupBn', 'sectionGroupEn', 'descriptionBn', 'descriptionEn', 'routineUrl', 'syllabusUrl', 'isPublished'])
        && data.levelOrder is number
        && data.classCode is string && data.classCode.size() >= 1 && data.classCode.size() <= 40 && data.classCode.matches('^[a-zA-Z0-9_\\-]+$')
        && data.nameBn is string && data.nameBn.size() >= 1 && data.nameBn.size() <= 120
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 120
        && data.sectionGroupBn is string && data.sectionGroupBn.size() >= 1 && data.sectionGroupBn.size() <= 200
        && data.sectionGroupEn is string && data.sectionGroupEn.size() >= 1 && data.sectionGroupEn.size() <= 200
        && data.descriptionBn is string && data.descriptionBn.size() >= 1 && data.descriptionBn.size() <= 1500
        && data.descriptionEn is string && data.descriptionEn.size() >= 1 && data.descriptionEn.size() <= 1500
        && isOptionalString(data, 'routineUrl', 500)
        && isOptionalString(data, 'syllabusUrl', 500)
        && data.isPublished is bool;
    }

    function isValidAcademicResource(data) {
      return data.keys().hasAll(['resourceType', 'titleBn', 'titleEn', 'classNameBn', 'classNameEn', 'publishDate', 'order', 'isPublished'])
        && data.keys().hasOnly(['resourceType', 'titleBn', 'titleEn', 'classNameBn', 'classNameEn', 'publishDate', 'fileUrl', 'order', 'isPublished'])
        && data.resourceType is string && data.resourceType in ['class_routine', 'exam_routine', 'syllabus', 'course_plan', 'calendar']
        && data.titleBn is string && data.titleBn.size() >= 1 && data.titleBn.size() <= 300
        && data.titleEn is string && data.titleEn.size() >= 1 && data.titleEn.size() <= 300
        && data.classNameBn is string && data.classNameBn.size() >= 1 && data.classNameBn.size() <= 120
        && data.classNameEn is string && data.classNameEn.size() >= 1 && data.classNameEn.size() <= 120
        && data.publishDate is string && data.publishDate.size() >= 1 && data.publishDate.size() <= 40
        && isOptionalString(data, 'fileUrl', 500)
        && data.order is number
        && data.isPublished is bool;
    }

    function isValidNotice(data) {
      return data.keys().hasAll(['serial', 'titleBn', 'titleEn', 'category', 'publishDate', 'summaryBn', 'summaryEn', 'isImportant', 'isPublished'])
        && data.keys().hasOnly([
          'serial',
          'titleBn',
          'titleEn',
          'category',
          'publishDate',
          'year',
          'summaryBn',
          'summaryEn',
          'detailsBn',
          'detailsEn',
          'attachmentUrl',
          'attachmentType',
          'externalUrl',
          'isImportant',
          'isPublished',
          'updatedAt'
        ])
        && data.serial is number
        && data.titleBn is string && data.titleBn.size() >= 1 && data.titleBn.size() <= 400
        && data.titleEn is string && data.titleEn.size() >= 1 && data.titleEn.size() <= 400
        && data.category is string && data.category in ['academic', 'admission', 'examination', 'recruitment', 'general']
        && data.publishDate is string && data.publishDate.size() >= 1 && data.publishDate.size() <= 40
        && isOptionalString(data, 'year', 10)
        && data.summaryBn is string && data.summaryBn.size() >= 1 && data.summaryBn.size() <= 2000
        && data.summaryEn is string && data.summaryEn.size() >= 1 && data.summaryEn.size() <= 2000
        && isOptionalString(data, 'detailsBn', 4000)
        && isOptionalString(data, 'detailsEn', 4000)
        && isOptionalString(data, 'attachmentUrl', 600)
        && (!('attachmentType' in data) || data.attachmentType in ['pdf', 'image'])
        && isOptionalString(data, 'externalUrl', 600)
        && data.isImportant is bool
        && data.isPublished is bool
        && isOptionalTimestamp(data, 'updatedAt');
    }

    function isValidGalleryItem(data) {
      return data.keys().hasAll(['titleBn', 'titleEn', 'category', 'imageUrl', 'order', 'isPublished'])
        && data.keys().hasOnly(['titleBn', 'titleEn', 'category', 'imageUrl', 'dateLabel', 'order', 'isPublished', 'updatedAt'])
        && data.titleBn is string && data.titleBn.size() >= 1 && data.titleBn.size() <= 250
        && data.titleEn is string && data.titleEn.size() >= 1 && data.titleEn.size() <= 250
        && data.category is string && data.category in ['campus', 'events', 'science_fair', 'cultural', 'guardians_meeting', 'transport']
        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 600
        && isOptionalString(data, 'dateLabel', 80)
        && data.order is number
        && data.isPublished is bool
        && isOptionalTimestamp(data, 'updatedAt');
    }

    function isValidNewsItem(data) {
      return data.keys().hasAll(['titleBn', 'titleEn', 'publishDate', 'summaryBn', 'summaryEn', 'isPublished'])
        && data.keys().hasOnly([
          'type',
          'titleBn',
          'titleEn',
          'publishDate',
          'category',
          'categoryBn',
          'categoryEn',
          'summaryBn',
          'summaryEn',
          'detailsBn',
          'detailsEn',
          'imageUrl',
          'extraImages',
          'attachmentUrl',
          'isPublished',
          'updatedAt'
        ])
        && (!('type' in data) || data.type in ['achievement', 'event', 'news'])
        && data.titleBn is string && data.titleBn.size() >= 1 && data.titleBn.size() <= 400
        && data.titleEn is string && data.titleEn.size() >= 1 && data.titleEn.size() <= 400
        && data.publishDate is string && data.publishDate.size() >= 1 && data.publishDate.size() <= 80
        && isOptionalString(data, 'category', 100)
        && isOptionalString(data, 'categoryBn', 100)
        && isOptionalString(data, 'categoryEn', 100)
        && data.summaryBn is string && data.summaryBn.size() >= 1 && data.summaryBn.size() <= 3000
        && data.summaryEn is string && data.summaryEn.size() >= 1 && data.summaryEn.size() <= 3000
        && isOptionalString(data, 'detailsBn', 4000)
        && isOptionalString(data, 'detailsEn', 4000)
        && isOptionalString(data, 'imageUrl', 600)
        && (!('extraImages' in data) || (data.extraImages is list && data.extraImages.size() <= 10))
        && isOptionalString(data, 'attachmentUrl', 600)
        && data.isPublished is bool
        && isOptionalTimestamp(data, 'updatedAt');
    }

    function isValidEventItem(data) {
      return data.keys().hasAll(['titleBn', 'titleEn', 'eventDate', 'descriptionBn', 'descriptionEn', 'isPublished'])
        && data.keys().hasOnly(['titleBn', 'titleEn', 'eventDate', 'descriptionBn', 'descriptionEn', 'imageUrl', 'isPublished'])
        && data.titleBn is string && data.titleBn.size() >= 1 && data.titleBn.size() <= 300
        && data.titleEn is string && data.titleEn.size() >= 1 && data.titleEn.size() <= 300
        && data.eventDate is string && data.eventDate.size() >= 1 && data.eventDate.size() <= 60
        && data.descriptionBn is string && data.descriptionBn.size() >= 1 && data.descriptionBn.size() <= 2500
        && data.descriptionEn is string && data.descriptionEn.size() >= 1 && data.descriptionEn.size() <= 2500
        && isOptionalString(data, 'imageUrl', 500)
        && data.isPublished is bool;
    }

    function isValidFacility(data) {
      return data.keys().hasAll(['titleBn', 'titleEn', 'descriptionBn', 'descriptionEn', 'order', 'isPublished'])
        && data.keys().hasOnly([
          'titleBn',
          'titleEn',
          'descriptionBn',
          'descriptionEn',
          'highlightsBn',
          'highlightsEn',
          'imageUrl',
          'order',
          'isPublished',
          'updatedAt'
        ])
        && data.titleBn is string && data.titleBn.size() >= 1 && data.titleBn.size() <= 200
        && data.titleEn is string && data.titleEn.size() >= 1 && data.titleEn.size() <= 200
        && data.descriptionBn is string && data.descriptionBn.size() >= 1 && data.descriptionBn.size() <= 1500
        && data.descriptionEn is string && data.descriptionEn.size() >= 1 && data.descriptionEn.size() <= 1500
        && (!('highlightsBn' in data) || (data.highlightsBn is list && data.highlightsBn.size() <= 12))
        && (!('highlightsEn' in data) || (data.highlightsEn is list && data.highlightsEn.size() <= 12))
        && isOptionalString(data, 'imageUrl', 600)
        && data.order is number
        && data.isPublished is bool
        && isOptionalTimestamp(data, 'updatedAt');
    }

    function isValidTransportInfo(data) {
      return data.keys().hasAll(['titleBn', 'titleEn', 'descriptionBn', 'descriptionEn', 'order', 'isPublished'])
        && data.keys().hasOnly(['titleBn', 'titleEn', 'descriptionBn', 'descriptionEn', 'imageUrl', 'order', 'isPublished'])
        && data.titleBn is string && data.titleBn.size() >= 1 && data.titleBn.size() <= 200
        && data.titleEn is string && data.titleEn.size() >= 1 && data.titleEn.size() <= 200
        && data.descriptionBn is string && data.descriptionBn.size() >= 1 && data.descriptionBn.size() <= 1500
        && data.descriptionEn is string && data.descriptionEn.size() >= 1 && data.descriptionEn.size() <= 1500
        && isOptionalString(data, 'imageUrl', 500)
        && data.order is number
        && data.isPublished is bool;
    }

    function isValidSiteSetting(data) {
      return data.keys().hasAll(['schoolNameBn', 'schoolNameEn', 'eiin', 'establishedYear', 'addressBn', 'addressEn', 'phonePrimary', 'emailPrimary', 'totalTeachers', 'totalClasses', 'isPublished'])
        && data.keys().hasOnly([
          'schoolNameBn',
          'schoolNameEn',
          'shortName',
          'eiin',
          'establishedYear',
          'inauguratedDateBn',
          'inauguratedDateEn',
          'addressBn',
          'addressEn',
          'phonePrimary',
          'phoneSecondary',
          'emailPrimary',
          'emailSecondary',
          'facebookUrl',
          'mapEmbedUrl',
          'totalStudents',
          'totalTeachers',
          'totalStaff',
          'totalClasses',
          'logoUrl',
          'youtubeUrl',
          'linkedinUrl',
          'footerTaglineEn',
          'footerTaglineBn',
          'isPublished',
          'updatedAt'
        ])
        && data.schoolNameBn is string && data.schoolNameBn.size() >= 1 && data.schoolNameBn.size() <= 250
        && data.schoolNameEn is string && data.schoolNameEn.size() >= 1 && data.schoolNameEn.size() <= 250
        && isOptionalString(data, 'shortName', 40)
        && data.eiin is string && data.eiin.size() >= 1 && data.eiin.size() <= 30
        && data.establishedYear is string && data.establishedYear.size() >= 1 && data.establishedYear.size() <= 20
        && isOptionalString(data, 'inauguratedDateBn', 120)
        && isOptionalString(data, 'inauguratedDateEn', 120)
        && data.addressBn is string && data.addressBn.size() >= 1 && data.addressBn.size() <= 300
        && data.addressEn is string && data.addressEn.size() >= 1 && data.addressEn.size() <= 300
        && data.phonePrimary is string && data.phonePrimary.size() >= 1 && data.phonePrimary.size() <= 40
        && isOptionalString(data, 'phoneSecondary', 40)
        && data.emailPrimary is string && data.emailPrimary.size() >= 1 && data.emailPrimary.size() <= 160
        && isOptionalString(data, 'emailSecondary', 160)
        && isOptionalString(data, 'facebookUrl', 400)
        && isOptionalString(data, 'mapEmbedUrl', 1000)
        && isOptionalString(data, 'totalStudents', 40)
        && data.totalTeachers is number
        && isOptionalNullableNumber(data, 'totalStaff', 0, 1000)
        && data.totalClasses is number
        && isOptionalString(data, 'logoUrl', 600)
        && isOptionalString(data, 'youtubeUrl', 400)
        && isOptionalString(data, 'linkedinUrl', 400)
        && isOptionalString(data, 'footerTaglineEn', 300)
        && isOptionalString(data, 'footerTaglineBn', 300)
        && data.isPublished is bool
        && isOptionalTimestamp(data, 'updatedAt');
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll(['senderName', 'senderEmail', 'senderPhone', 'subject', 'message', 'status', 'createdAt'])
        && data.keys().hasOnly(['senderName', 'senderEmail', 'senderPhone', 'subject', 'message', 'status', 'createdAt', 'updatedAt'])
        && data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 120
        && data.senderEmail is string && data.senderEmail.size() >= 5 && data.senderEmail.size() <= 160 && data.senderEmail.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.senderPhone is string && data.senderPhone.size() >= 6 && data.senderPhone.size() <= 30 && data.senderPhone.matches('^[0-9+\\-\\s()]{6,30}$')
        && data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 200
        && data.message is string && data.message.size() >= 10 && data.message.size() <= 3000
        && data.status is string && data.status in ['new', 'read', 'archived']
        && data.createdAt is timestamp
        && isOptionalTimestamp(data, 'updatedAt');
    }

    function isValidLegacyAdminUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt'])
        && data.keys().hasOnly(['email', 'role', 'createdAt'])
